# App Store Connect API Key Configuration
# Rename this file to .env and fill in your values
# DO NOT commit the .env file to version control

# The Key ID from App Store Connect
APP_STORE_CONNECT_API_KEY_KEY_ID=""

# The Issuer ID from App Store Connect
APP_STORE_CONNECT_API_KEY_ISSUER_ID=""

# The content of the .p8 key file
# Recommended: Base64 encode the content of your .p8 file
# Run `cat AuthKey_XXXX.p8 | base64` to get this value
APP_STORE_CONNECT_API_KEY_KEY_CONTENT=""
