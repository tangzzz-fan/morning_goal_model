default_platform(:ios)

platform :ios do
  before_all do
    # App Store Connect API Key configuration
    # Documentation: https://docs.fastlane.tools/actions/app_store_connect_api_key/
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_KEY_CONTENT"],
      is_key_content_base64: true, # Recommend using Base64 for environment variables to avoid newline issues
      in_house: false
    )
  end

  desc "Certificates"
  lane :certificates do
    # match will automatically use the API Key from the context (set in before_all)
    match(type: "development", readonly: false)
    match(type: "appstore", readonly: false)
  end

  desc "Update Xcode Signing settings to use Match profiles"
  lane :setup_signing do
    # Ensure certificates are there
    certificates
    
    # Configure Debug (Development)
    update_code_signing_settings(
      use_automatic_signing: false,
      targets: ["MorningGoal"],
      path: "MorningGoal.xcodeproj",
      profile_name: "match Development com.tango.MorningGoal",
      build_configurations: ["Debug"],
      code_sign_identity: "Apple Development"
    )
    
    # Configure Release (App Store)
    update_code_signing_settings(
      use_automatic_signing: false,
      targets: ["MorningGoal"],
      path: "MorningGoal.xcodeproj",
      profile_name: "match AppStore com.tango.MorningGoal",
      build_configurations: ["Release"],
      code_sign_identity: "Apple Distribution"
    )
  end

  desc "Build the app"
  lane :build do
    setup_signing
    gym(
      scheme: "MorningGoal",
      export_method: "app-store",
      include_bitcode: false
    )
  end
  
  desc "Push a new beta build to TestFlight"
  lane :beta do
    # Ensure clean status (optional, can be commented out if you want to build dirty state)
    # ensure_git_status_clean
    
    # Increment build number
    increment_build_number(xcodeproj: "MorningGoal.xcodeproj")
    
    # Build
    build
    
    # Upload to TestFlight
    # Distribute to external testers if 'distribute_external' is true
    upload_to_testflight(
      skip_waiting_for_build_processing: true # Don't wait for processing to finish
    )
  end
  
  desc "Release to App Store Connect"
  lane :release do
    # Build
    build
    
    # Upload to App Store
    # This will upload the binary and metadata.
    # set 'force: true' to skip the HTML report verification
    upload_to_app_store(
      force: true,
      submit_for_review: false, # Set to true if you want to automatically submit
      reject_if_possible: true, # Reject any previous build in review
      skip_metadata: true,      # Set to false if you want to upload metadata
      skip_screenshots: true    # Set to false if you want to upload screenshots
    )
  end
  
  desc "Daily Build (Runs tests, increments build number, uploads to TestFlight)"
  lane :daily_build do
    # Pull latest changes
    # git_pull
    
    # Run tests
    # run_tests(scheme: "MorningGoal")
    
    # Increment build number
    increment_build_number(xcodeproj: "MorningGoal.xcodeproj")
    
    # Build
    build
    
    # Upload to TestFlight
    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end

  desc "Reset Certificates (Use when 'Max number of certificates' error occurs)"
  lane :reset_certificates do
    # Nukes existing certificates to clear the limit
    # WARNING: This revokes certificates for ALL apps in this account/team!
    # This is necessary when you hit the "reached the maximum number of available Distribution certificates" error
    # and those certificates are not currently in your match git repository.
    
    # Revoke Development certificates
    match_nuke(type: "development", skip_confirmation: true)
    
    # Revoke Distribution certificates
    match_nuke(type: "distribution", skip_confirmation: true)
    
    # Re-generate everything properly
    certificates
  end
end
